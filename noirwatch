# Require bash 4.3 or newer for associative arrays and namerefs.
# This check uses POSIX syntax so older shells can still print the error.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
    { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]; }; then
    printf '%s requires bash 4.3 or newer (running %s).\n' "${0##*/}" "${BASH_VERSION:-unknown}" >&2
    printf 'On macOS, install it with: brew install bash\n' >&2
    exit 1
fi

# App version and name
readonly APP_NAME="NoirWatch"
readonly VERSION=1.4.0
readonly LAST_UPDATED="2026-10-13"

# TODO:
#  - Add more notification methods (email, slack, discord, etc.)

# ==============================
# Application Specific Variables
# ==============================

# Initialize CLI URLS as an empty array
CLI_URLS=()

# Default threshold percentage (higher is less sensitive)
THRESHOLD=0

# Version of the cached content format. Bump it when normalization changes so old caches are ignored.
readonly CACHE_FORMAT="v2"

# Elements whose text is ignored when comparing pages
readonly IGNORED_ELEMENTS=("script" "style" "noscript" "template" "iframe" "svg" "nav" "aside")

# Class or id names whose text is ignored when comparing pages
readonly IGNORED_NAMES=("ad" "ads" "advert" "advertisement" "promo" "banner" "sponsored" "timestamp" "sidebar" "cookie-banner")

# Application specific dependencies
DEPENDENCIES=("diff" "shasum" "timeout" "xmllint")

# Application specific configuration keys
APP_CONFIG_KEYS=("THRESHOLD")

# ==============================
# Base Application Variables
# ==============================

# Default configuration file location (full default path added during initialization)
CONFIG_FILE_NAME="$(basename "$0").json"
SKIP_CONFIG_KEYS=("PID_FILE")

# Configuration keys that may be set from the configuration file
CONFIG_KEYS=(
    "CACHE_DIR" "LOG_FILE" "CHECK_INTERVAL" "TIMEOUT" "REPEAT" "SYSTEM_NAME"
    "PUSHOVER_NOTIFICATION" "PUSHOVER_USER_KEY" "PUSHOVER_API_TOKEN" "DESKTOP_NOTIFICATION"
    "VERBOSE" "LOG_LEVEL" "${APP_CONFIG_KEYS[@]}"
)

# Master directory to store all cache files (full default path added during initialization)
CACHE_DIR="$(basename "$0")_cache"

# Default log file location (full default path added during initialization)
LOG_FILE_NAME="$(basename "$0").log"
INIT_FORCE=false

# Lock file (full default path added during initialization)
PID_FILE_NAME="$(basename "$0").pid"

# Service mode flag
IS_SERVICE=false

# PID of the current interruptible sleep
SLEEP_PID=""

# Default check interval (in seconds)
CHECK_INTERVAL="60s"

# Default timeout interval (in seconds)
TIMEOUT="5s"

# Default check repeat (0=infinite)
REPEAT=0

# Pushover notification options
PUSHOVER_NOTIFICATION=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Native desktop notification options
DESKTOP_NOTIFICATION=false

# Log levels
# Define log levels directly as an associative array
declare -A LOG_LEVELS_MAP=(
    ["FATAL"]=0
    ["ERROR"]=1
    ["WARN"]=2
    ["INFO"]=3
    ["DEBUG"]=4
)
LOG_LEVEL="INFO"
VERBOSE=false

# System host name
SYSTEM_NAME=""

# ANSI color codes (disabled when output is not a terminal or NO_COLOR is set)
# shellcheck disable=SC2034 # Not every app uses every color
if [[ -z "${NO_COLOR:-}" && (-t 1 || -t 2) ]]; then
    readonly RED=$'\033[0;31m'
    readonly RED_BG=$'\033[41m'
    readonly GREEN=$'\033[0;32m'
    readonly GREEN_BG=$'\033[42m'
    readonly YELLOW=$'\033[1;33m'
    readonly YELLOW_BG=$'\033[43m'
    readonly ORANGE=$'\033[0;33m'
    readonly ORANGE_BG=$'\033[43m'
    readonly NC=$'\033[0m' # No Color
else
    readonly RED="" RED_BG="" GREEN="" GREEN_BG="" YELLOW="" YELLOW_BG="" ORANGE="" ORANGE_BG="" NC=""
fi

# ==============================
# Utility Functions
# ==============================

# Function: Show version information
show_version() {
    printf "%s version: %s\n" "$APP_NAME" "$VERSION"
    printf "Last updated: %s\n" "$LAST_UPDATED"
}

# Function: Check for required command-line utilities
check_dependencies() {
    DEPENDENCIES+=("cat" "curl" "hostname" "jq" "sed")

    case "$OSTYPE" in
    linux*)
        DEPENDENCIES+=("realpath")
        ;;
    darwin*)
        DEPENDENCIES+=("grealpath")
        ;;
    cygwin* | msys* | win32*)
        DEPENDENCIES+=("powershell")
        ;;
    *)
        log_message "FATAL" "Unsupported OS: $OSTYPE" "$LINENO"
        exit 1
        ;;
    esac

    local cmd
    for cmd in "${DEPENDENCIES[@]}"; do
        # Debug log for each dependency being checked
        log_message "DEBUG" "Checking if dependency '$cmd' is installed..." "$LINENO"

        if ! command -v "$cmd" &>/dev/null; then
            log_message "FATAL" "Error: $cmd is not installed. Please install it and try again." "$LINENO"
            exit 1
        else
            log_message "DEBUG" "Success: $cmd is installed!" "$LINENO"
        fi
    done

    # Optional success debug log
    log_message "DEBUG" "All dependencies are installed." "$LINENO"
}

# Function: Check if an array contains a value
array_contains() {
    local needle="$1"
    shift
    local item

    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done

    return 1
}

# Function: Get system host name
get_hostname() {
    case "$OSTYPE" in
    linux* | darwin*)
        hostname
        ;;
    cygwin* | msys* | win32*)
        powershell -NoProfile -Command "[System.Net.Dns]::GetHostName()"
        ;;
    *)
        log_message "FATAL" "Unsupported OS: $OSTYPE" "$LINENO"
        exit 1
        ;;
    esac
}

# Function: Normalize paths
normalize_path() {
    local path="$1"
    local normalized_path

    case "$OSTYPE" in
    linux*)
        if command -v realpath >/dev/null 2>&1; then
            # Use `realpath -m` for non-existent paths on Linux
            normalized_path=$(realpath -m "$path" 2>/dev/null || echo "$(realpath -m "$(dirname "$path")")/$(basename "$path")")
        else
            echo "realpath not found on Linux" >&2
            exit 1
        fi
        ;;
    darwin*)
        if command -v grealpath >/dev/null 2>&1; then
            # Use `grealpath -m` for non-existent paths on macOS
            normalized_path=$(grealpath -m "$path" 2>/dev/null || echo "$(grealpath -m "$(dirname "$path")")/$(basename "$path")")
        else
            echo "grealpath not found on macOS. Install it using 'brew install coreutils'" >&2
            exit 1
        fi
        ;;
    cygwin* | msys* | win32*)
        # Use PowerShell to resolve the path on Windows. Single quotes are doubled so the path stays a literal string.
        local ps_path="${path//\'/\'\'}"
        normalized_path=$(powershell -NoProfile -Command "try { (Resolve-Path -LiteralPath '$ps_path').Path } catch { [System.IO.Path]::GetFullPath('$ps_path') }")
        ;;
    *)
        echo "Unsupported OS: $OSTYPE" >&2
        exit 1
        ;;
    esac

    echo "$normalized_path"
}

# Function: Normalize filenames
normalize_filename() {
    local filename="$1"
    filename=$(echo "$filename" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -d '\\/:*?"<>|')
    echo "$filename"
}

# Function: Get the root configuration directory and set the config file path
get_config_path() {
    local append_path="$1"
    local config_dir

    case "$OSTYPE" in
    linux* | darwin*)
        config_dir="$HOME/.config"
        ;;
    cygwin* | msys* | win32*)
        config_dir="$APPDATA"
        ;;
    *)
        log_message "FATAL" "Unsupported OS: $OSTYPE" "$LINENO"
        exit 1
        ;;
    esac

    normalize_path "$config_dir/$append_path"
}

# Function: Get the temporary directory path
get_temp_path() {
    local append_path="$1"
    local temp_dir

    case "$OSTYPE" in
    linux* | darwin*)
        temp_dir="/tmp"
        ;;
    cygwin* | msys* | win32*)
        temp_dir="$TEMP"
        ;;
    *)
        log_message "FATAL" "Unsupported OS: $OSTYPE" "$LINENO"
        exit 1
        ;;
    esac

    normalize_path "$temp_dir/$append_path"
}

# Function: Edit a specified file
edit_file() {
    local file="$1"

    if [[ -z "$file" ]]; then
        log_message "FATAL" "No file specified to edit." "$LINENO"
        exit 1
    fi

    if [[ ! -f "$file" ]]; then
        log_message "FATAL" "File not found: $file" "$LINENO"
        exit 1
    fi

    if [[ -n "${EDITOR:-}" ]]; then
        # EDITOR may include arguments, such as "code --wait"
        local editor_cmd
        read -r -a editor_cmd <<<"$EDITOR"
        if command -v "${editor_cmd[0]}" &>/dev/null; then
            "${editor_cmd[@]}" "$file"
            exit $?
        else
            log_message "FATAL" "Specified editor '$EDITOR' is not available." "$LINENO"
            exit 1
        fi
    fi

    case "$OSTYPE" in
    darwin*)
        open "$file"
        ;;
    linux*)
        if ! command -v xdg-open &>/dev/null; then
            log_message "FATAL" "No editor found. Set the EDITOR environment variable, for example: EDITOR=nano" "$LINENO"
            exit 1
        fi
        xdg-open "$file"
        ;;
    cygwin* | msys* | win32*)
        start "" "$file"
        ;;
    *)
        log_message "FATAL" "Unsupported OS: $OSTYPE" "$LINENO"
        exit 1
        ;;
    esac

    exit 0
}

# Function: Convert a frequency/interval string to seconds
# Accepts a whole number with an optional unit: s (seconds), m (minutes), h (hours) or d (days).
get_interval_in_seconds() {
    local input_frequency="$1"

    if [[ ! "$input_frequency" =~ ^([0-9]+)([smhd]?)$ ]]; then
        return 1
    fi

    # Force base 10 so values such as "08" are not read as octal
    local interval=$((10#${BASH_REMATCH[1]}))

    case "${BASH_REMATCH[2]}" in
    m) interval=$((interval * 60)) ;;
    h) interval=$((interval * 3600)) ;;
    d) interval=$((interval * 86400)) ;;
    esac

    echo "$interval"
}

# Function: Convert date to human-readable format
convert_date() {
    local date_str="$1"
    local human_readable_date

    if [[ "$OSTYPE" == "linux"* ]]; then
        human_readable_date=$(date -d "$date_str" +"%Y-%m-%d %H:%M:%S %Z")
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        human_readable_date=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$date_str" +"%Y-%m-%d %H:%M:%S %Z")
    elif [[ "$OSTYPE" == "cygwin" || "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
        human_readable_date=$(date -d "$date_str" +"%Y-%m-%d %H:%M:%S %Z")
    else
        human_readable_date="$date_str"
    fi

    echo "$human_readable_date"
}

# Function: Sleep in a way that signal handlers can interrupt
interruptible_sleep() {
    sleep "$1" &
    SLEEP_PID=$!
    wait "$SLEEP_PID"
    SLEEP_PID=""
}

# Function: Stop any running interruptible sleep
stop_sleep() {
    if [[ -n "$SLEEP_PID" ]]; then
        kill "$SLEEP_PID" 2>/dev/null
        SLEEP_PID=""
    fi
}

# ==============================
# Logging and Messaging Functions
# ==============================

# Function: Check if the current log level is at or above a given level
log_at_or_above() {
    local level_name=$1

    # Get indices from the associative array
    local current_level_index=${LOG_LEVELS_MAP[$LOG_LEVEL]}
    local check_level_index=${LOG_LEVELS_MAP[$level_name]}

    # Compare indices
    if [[ $current_level_index -ge $check_level_index ]]; then
        return 0 # true: log level is at or above the given level
    else
        return 1 # false: log level is below the given level
    fi
}

# Function: Log messages to console
log_to_console() {
    local log_level_name=$1
    local message=$2
    local line_number=$3
    local timestamp=$4
    local output_message="$message"

    # If verbose mode or debug level is enabled, format the output with timestamp and log level
    if [[ "$VERBOSE" = true || "$LOG_LEVEL" = "DEBUG" ]]; then
        output_message="$timestamp [$log_level_name] $message (Line: $line_number)"
    fi

    # Remove non-printable characters
    output_message="${output_message//[^[:print:]]/}"

    # Handle different log levels
    case $log_level_name in
    "FATAL")
        printf "%s%s%s\n" "$RED_BG" "$output_message" "$NC" >&2
        ;;
    "ERROR")
        printf "%s%s%s\n" "$RED" "$output_message" "$NC" >&2
        ;;
    "WARN")
        printf "%s%s%s\n" "$YELLOW" "$output_message" "$NC" >&2
        ;;
    *)
        printf "%s\n" "$output_message" >&2
        ;;
    esac
}

# Function: Log messages
log_message() {
    local log_level_name=$1
    local message=$2
    local line_number=${3:-"N/A"}

    # Generate an ISO 8601 timestamp in UTC without starting a subprocess
    local timestamp
    TZ=UTC printf -v timestamp "%(%Y-%m-%dT%H:%M:%SZ)T" -1

    # Validate log level name
    if [[ -z "$log_level_name" || -z "${LOG_LEVELS_MAP[$log_level_name]:-}" ]]; then
        printf "%s [ERROR] Invalid log level '%s'. Defaulting to INFO.\n" "$timestamp" "$log_level_name" >&2
        log_level_name="INFO"
    fi

    # Validate current log level
    if [[ -z "$LOG_LEVEL" || -z "${LOG_LEVELS_MAP[$LOG_LEVEL]:-}" ]]; then
        printf "%s [ERROR] Invalid global log level '%s'. Defaulting to INFO.\n" "$timestamp" "$LOG_LEVEL" >&2
        LOG_LEVEL="INFO"
    fi

    # Skip messages below the current log level
    log_at_or_above "$log_level_name" || return 0

    # Format the log message
    local formatted_message="$timestamp [$log_level_name] $message"
    if [[ "$VERBOSE" = true || "$LOG_LEVEL" = "DEBUG" ]]; then
        formatted_message="$formatted_message (Line: $line_number)"
    fi

    # Remove non-printable characters so messages cannot break the log format
    formatted_message="${formatted_message//[^[:print:]]/}"

    # Log to file if the log file exists
    if [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]]; then
        printf "%s\n" "$formatted_message" >>"$LOG_FILE" 2>/dev/null || true
    fi

    # Always log to the console if not running as a service, or if no log file exists
    if [[ "$IS_SERVICE" != true || -z "${LOG_FILE:-}" || ! -f "$LOG_FILE" ]]; then
        log_to_console "$log_level_name" "$message" "$line_number" "$timestamp"
    fi
}

# Function: Initialize the log file
init_log() {
    if [[ -z "$LOG_FILE" ]]; then
        log_message "FATAL" "LOG_FILE variable is not set." "$LINENO"
        exit 1
    fi

    # Ensure the directory for the log file exists
    local log_dir
    log_dir=$(dirname "$LOG_FILE")
    if [[ ! -d "$log_dir" ]]; then
        if ! mkdir -p "$log_dir"; then
            log_message "FATAL" "Failed to create directory: $log_dir" "$LINENO"
            exit 1
        fi
        log_message "DEBUG" "Created log file directory: $log_dir" "$LINENO"
    fi

    if [[ ! -f "$LOG_FILE" ]]; then
        # Attempt to create the log file, readable only by the current user
        if (umask 077 && touch "$LOG_FILE") 2>/dev/null; then
            log_message "DEBUG" "Created log file: $LOG_FILE" "$LINENO"
        else
            log_message "FATAL" "Failed to create log file: $LOG_FILE" "$LINENO"
            exit 1
        fi
    else
        # Check if the log file is writable
        if [[ ! -w "$LOG_FILE" ]]; then
            log_message "FATAL" "Log file exists but is not writable: $LOG_FILE" "$LINENO"
            exit 1
        fi
        log_message "DEBUG" "Log file already exists and is writable: $LOG_FILE" "$LINENO"
    fi
}

# Function: Log the log file to the screen
show_log() {
    if [[ -f "$LOG_FILE" ]]; then
        cat "$LOG_FILE"
    else
        log_message "INFO" "Log file not found: $LOG_FILE" "$LINENO"
    fi
    exit 0
}

# ==============================
# Cache Management Functions
# ==============================

# Function: Check if a directory is a mount point
is_mount_point() {
    local dir="$1"

    if [[ "$OSTYPE" == "linux"* ]]; then
        # Use `findmnt` if available on Linux
        if command -v findmnt >/dev/null 2>&1; then
            findmnt -n -o TARGET --mountpoint "$dir" >/dev/null 2>&1
            return $?
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS: Use `df` to check if the directory is a separate mount
        if [[ $(df "$dir" 2>/dev/null | tail -n +2 | awk '{print $NF}') == "$dir" ]]; then
            return 0
        fi
    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        # Windows: Skip mount point check as it's less relevant for typical use cases
        return 1
    fi

    # Default: Assume it's not a mount point
    return 1
}

# Function: Check if a directory is critical
is_critical_directory() {
    local dir="$1"

    # Remove a trailing slash so "/home/" matches "/home"; "/" becomes empty
    [[ "$dir" != "/" ]] && dir="${dir%/}"

    local critical_dirs=(
        "" "/" "/home" "/bin" "/boot" "/dev" "/etc" "/lib" "/lib64" "/proc" "/root" "/sbin" "/sys" "/usr" "/var" "/tmp"
        "/Users" "/Applications" "/Library" "/System" "/opt" "/private" "/private/tmp" "/private/var"
        "C:\\" "C:\\Windows" "C:\\Program Files" "C:\\Program Files (x86)" "C:\\Users" "C:\\Documents and Settings"
    )

    # Check if the directory is in the list of critical directories
    if array_contains "$dir" "${critical_dirs[@]}"; then
        return 0 # true: critical directory
    fi

    # Protect the home directory and every directory above it
    if [[ -n "${HOME:-}" && ("$HOME" == "$dir" || "$HOME" == "$dir"/*) ]]; then
        return 0 # true: critical directory
    fi

    # Protect symbolic links
    if [[ -L "$dir" ]]; then
        return 0 # true: critical directory
    fi

    # Check if the directory is a mount point (cross-platform)
    if is_mount_point "$dir"; then
        return 0 # true: critical directory
    fi

    return 1 # false: not a critical directory
}

# Function: Delete all cached files
delete_cache() {
    log_message "INFO" "Deleting all cached files..." "$LINENO"

    # Ensure CACHE_DIR is defined and not empty
    if [[ -z "$CACHE_DIR" ]]; then
        log_message "FATAL" "CACHE_DIR is not set. Unable to proceed." "$LINENO"
        exit 1
    fi

    # Ensure CACHE_DIR exists
    if [[ ! -d "$CACHE_DIR" ]]; then
        log_message "FATAL" "Cache directory '$CACHE_DIR' does not exist." "$LINENO"
        exit 1
    fi

    # Prevent deletion of critical directories
    if is_critical_directory "$CACHE_DIR"; then
        log_message "FATAL" "Attempted to delete a critical directory '$CACHE_DIR'. Aborting." "$LINENO"
        exit 1
    fi

    # Refuse to delete the cache while the service is using it
    if [[ -n "${PID_FILE:-}" && -f "$PID_FILE" ]] && is_app_process "$(<"$PID_FILE")"; then
        log_message "FATAL" "$APP_NAME is running. Stop it with --stop before deleting the cache." "$LINENO"
        exit 1
    fi

    # Attempt to delete the cache directory
    if rm -rf "$CACHE_DIR"; then
        log_message "INFO" "Success: All cached files in '$CACHE_DIR' deleted." "$LINENO"
        exit 0
    else
        log_message "FATAL" "Failed to delete cached files in '$CACHE_DIR'." "$LINENO"
        exit 1
    fi
}

# Function: Initialize the cache directory
init_cache() {
    # Create the master cache directory, readable only by the current user
    if [[ ! -d "$CACHE_DIR" ]]; then
        if ! (umask 077 && mkdir -p "$CACHE_DIR"); then
            log_message "FATAL" "Failed to create cache directory: $CACHE_DIR" "$LINENO"
            exit 1
        fi
        log_message "DEBUG" "Created cache directory: $CACHE_DIR" "$LINENO"
    else
        log_message "DEBUG" "Cache directory already exists: $CACHE_DIR" "$LINENO"
    fi

    # Another user could otherwise control the PID file and cached content
    if [[ ! -O "$CACHE_DIR" ]]; then
        log_message "FATAL" "Cache directory '$CACHE_DIR' is owned by another user. Use --cache-dir to choose a different location." "$LINENO"
        exit 1
    fi
}

