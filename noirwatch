# Notification Functions
# ==============================

# Function: Send desktop notifications
send_desktop_notification() {
    local title="$1"
    local message="$2"

    [[ "$DESKTOP_NOTIFICATION" = true ]] || return 0

    case "$OSTYPE" in
    darwin*)
        # Pass the text as arguments so quotes in it cannot change the AppleScript
        if ! osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
            "$title" "$message" >/dev/null 2>&1; then
            log_message "ERROR" "Failed to send notification on macOS." "$LINENO"
        fi
        ;;
    linux*)
        if command -v notify-send &>/dev/null; then
            if ! notify-send -- "$title" "$message" >/dev/null 2>&1; then
                log_message "ERROR" "Failed to send notification on Linux." "$LINENO"
            fi
        else
            log_message "ERROR" "notify-send is not installed. Install it to enable notifications on Linux." "$LINENO"
        fi
        ;;
    cygwin* | msys* | win32*)
        # Pass the text through the environment so it is never parsed as PowerShell code
        # shellcheck disable=SC2016 # The single quotes are intentional; PowerShell expands $env:NOIR_*
        if ! NOIR_TITLE="$title" NOIR_MESSAGE="$message" powershell -NoProfile -NonInteractive -Command \
            'Add-Type -AssemblyName System.Windows.Forms, System.Drawing; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(10000, $env:NOIR_TITLE, $env:NOIR_MESSAGE, [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep -Seconds 6; $n.Dispose()' \
            >/dev/null 2>&1; then
            log_message "ERROR" "Failed to send notification on Windows." "$LINENO"
        fi
        ;;
    *)
        log_message "ERROR" "Desktop notifications are only supported on macOS, Linux, and Windows." "$LINENO"
        ;;
    esac
}

# Function: Send Pushover notifications
send_pushover_notification() {
    local title=$1
    local message=$2
    local website_url=$3
    local response

    [[ "$PUSHOVER_NOTIFICATION" = true ]] || return 0

    log_message "DEBUG" "Processing Pushover notification: $website_url" "$LINENO"
    log_message "DEBUG" "Message: $message" "$LINENO"

    # Check if PUSHOVER_API_TOKEN is set
    if [[ -z "$PUSHOVER_API_TOKEN" ]]; then
        log_message "ERROR" "Error: PUSHOVER_API_TOKEN is not set." "$LINENO"
        return 1
    fi

    # Check if USER_KEY is set
    if [[ -z "$PUSHOVER_USER_KEY" ]]; then
        log_message "ERROR" "Error: PUSHOVER_USER_KEY is not set." "$LINENO"
        return 1
    fi

    # Pushover keys are alphanumeric; anything else would break the curl configuration below
    if [[ ! "$PUSHOVER_API_TOKEN" =~ ^[A-Za-z0-9]+$ || ! "$PUSHOVER_USER_KEY" =~ ^[A-Za-z0-9]+$ ]]; then
        log_message "ERROR" "Error: PUSHOVER_API_TOKEN and PUSHOVER_USER_KEY may only contain letters and numbers." "$LINENO"
        return 1
    fi

    # Build the curl arguments as an array so message text is never evaluated by the shell
    local curl_args=(
        --silent --show-error --max-time 15
        --form-string "title=$title"
        --form-string "message=$message"
        --form-string "priority=0"
    )

    # Add URL options if website_url is defined
    if [[ -n "$website_url" ]]; then
        curl_args+=(--form-string "url=$website_url" --form-string "url_title=Visit Site")
    fi

    # Credentials are read from stdin so they never appear in the process list
    if ! response=$(printf 'form-string = "token=%s"\nform-string = "user=%s"\n' "$PUSHOVER_API_TOKEN" "$PUSHOVER_USER_KEY" |
        curl "${curl_args[@]}" --config - https://api.pushover.net/1/messages.json 2>&1) || [[ -z "$response" ]]; then
        log_message "ERROR" "Failed to send Pushover notification: $response" "$LINENO"
        return 1
    fi

    # Check if status is 1 (success)
    local status
    status=$(jq -r '.status // empty' <<<"$response" 2>/dev/null)
    if [[ "$status" != "1" ]]; then
        log_message "ERROR" "Pushover API returned an error: $response" "$LINENO"
        return 1
    fi

    log_message "DEBUG" "Pushover notification sent successfully." "$LINENO"
    return 0
}

# ==============================
# Process Execution Functions
# ==============================

# Function: Check if a PID belongs to a running instance of this app
is_app_process() {
    local pid="$1"
    local command

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1

    # Guard against PID reuse by checking the command line when ps supports it
    if command=$(ps -p "$pid" -o args= 2>/dev/null) && [[ -n "$command" ]]; then
        [[ "$command" == *"$(basename "$0")"* ]]
        return
    fi

    return 0
}

# Function: Handle termination signals
setup_signal_handlers() {
    trap 'cleanup_pid' EXIT
    trap 'stop_sleep; exit 130' INT
    trap 'stop_sleep; exit 143' TERM
}

# Function: Start the service
start_service() {
    log_message "INFO" "Starting $APP_NAME service..." "$LINENO"

    # Launch the service as a background process
    (
        IS_SERVICE=true
        # Keep running after the terminal that started the service closes
        trap '' HUP
        setup_signal_handlers
        main
    ) >/dev/null 2>&1 &
    local service_pid=$!
    echo "$service_pid" >"$PID_FILE"

    # Sleep briefly to ensure the background process has initialized
    sleep 1

    # Verify that the background process is running
    if ! is_app_process "$service_pid"; then
        log_message "FATAL" "Failed to start $APP_NAME service. Check the log file: $LOG_FILE" "$LINENO"
        cleanup_pid
        exit 1
    fi

    # The service is now running in the background
    log_message "INFO" "$APP_NAME service is running in the background with PID $service_pid." "$LINENO"
}

# Function: Stop the service
stop_service() {
    if [[ ! -f "$PID_FILE" ]]; then
        log_message "INFO" "No $APP_NAME service is currently running." "$LINENO"
        return 0
    fi

    local pid
    pid=$(<"$PID_FILE")
    if ! is_app_process "$pid"; then
        log_message "WARN" "No active $APP_NAME process found for PID $pid. Cleaning up stale PID file." "$LINENO"
        cleanup_pid
        return 0
    fi

    log_message "INFO" "Stopping $APP_NAME service with PID $pid..." "$LINENO"
    kill "$pid" 2>/dev/null

    # Wait up to 10 seconds for the service to exit
    local waited=0
    while kill -0 "$pid" 2>/dev/null && ((waited < 10)); do
        sleep 1
        waited=$((waited + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        log_message "WARN" "$APP_NAME service did not stop in time. Forcing it to stop." "$LINENO"
        kill -9 "$pid" 2>/dev/null
    fi

    cleanup_pid
    log_message "INFO" "$APP_NAME service stopped." "$LINENO"
}

# Function: Restart the service
restart_service() {
    log_message "INFO" "Restarting $APP_NAME service..." "$LINENO"
    stop_service
    show_config
    start_service
}

# Function: Check the status of the service
# Returns 0 when running and 3 when stopped (LSB convention)
status_service() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(<"$PID_FILE")
        if is_app_process "$pid"; then
            log_message "INFO" "$APP_NAME service is running with PID $pid." "$LINENO"
            return 0
        fi
        log_message "WARN" "$APP_NAME service is not running, but PID file exists. Cleaning up stale PID file." "$LINENO"
        cleanup_pid
    else
        log_message "INFO" "$APP_NAME service is not running." "$LINENO"
    fi
    return 3
}

# Function: Prevent running multiple interactive instances (except for specific cases)
check_already_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(<"$PID_FILE")
        if is_app_process "$pid"; then
            log_message "ERROR" "Another instance of the $APP_NAME is already running (PID: $pid)." "$LINENO"
            exit 1
        else
            log_message "WARN" "Stale $APP_NAME PID file found. Cleaning up." "$LINENO"
            rm -f "$PID_FILE"
        fi
    fi
}

# Function: Cleanup PID file on exit
cleanup_pid() {
    # Only remove the PID file if it belongs to this process or is stale
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(<"$PID_FILE")
        if [[ "$pid" == "$BASHPID" ]] || ! is_app_process "$pid"; then
            log_message "DEBUG" "Cleaning up $APP_NAME PID file." "$LINENO"
            rm -f "$PID_FILE"
        fi
    fi
}

# Function: Run the check
start_process() {
    # Handle status or stop service before checking for running instances
    if [[ "$SHOW_STATUS" == true ]]; then
        status_service
        exit $?
    fi

    if [[ "$STOP_SERVICE" == true ]]; then
        stop_service
        exit 0
    fi

    if [[ "$RESTART_SERVICE" == true ]]; then
        restart_service
        return
    fi

    # Check if an instance is already running
    check_already_running

    # Log and start the configuration
    log_message "INFO" "Starting $APP_NAME: $(date)" "$LINENO"
    show_config

    # Start the service or run interactively
    if [[ "$START_SERVICE" == true ]]; then
        start_service
    else
        log_message "INFO" "Running $APP_NAME interactively..." "$LINENO"
        setup_signal_handlers
        echo $$ >"$PID_FILE"
        main
    fi
}

# ==============================
# Configuration and Initialization Functions
# ==============================

# Function: Check if a configuration key holds a secret
is_secret_key() {
    [[ "$1" == *TOKEN* || "$1" == *KEY* || "$1" == *SECRET* || "$1" == *PASSWORD* ]]
}

# Function: Load configuration from JSON file
load_config() {
    local config_file_path="$1"

    if [[ ! -f "$config_file_path" ]]; then
        if key_exists "CONFIG_FILE"; then
            log_message "FATAL" "Configuration file not found: $config_file_path" "$LINENO"
            exit 1
        fi
        log_message "DEBUG" "No configuration file at $config_file_path. Using defaults." "$LINENO"
        return 0
    fi

    # Use jq to parse the JSON into key=value lines
    local jq_output
    if ! jq_output=$(jq -r '(.configuration // {}) | to_entries[] | "\(.key)=\(.value // "" | tostring)"' "$config_file_path" 2>&1); then
        log_message "FATAL" "Configuration file is not valid JSON: $config_file_path ($jq_output)" "$LINENO"
        exit 1
    fi

    local key value
    while IFS="=" read -r key value; do
        # Skip empty values and settings given on the command line
        [[ -z "$key" || -z "$value" ]] && continue
        key_exists "$key" && continue

        # Only accept known keys so the file cannot overwrite unrelated shell variables
        if ! array_contains "$key" "${CONFIG_KEYS[@]}"; then
            log_message "WARN" "Ignoring unknown configuration key '$key' in $config_file_path" "$LINENO"
            continue
        fi

        [[ "$key" == *_DIR || "$key" == *_FILE ]] && value="$(normalize_path "$value")"
        printf -v "$key" "%s" "$value"

        if is_secret_key "$key"; then
            log_message "DEBUG" "Setting $key=********" "$LINENO"
        else
            log_message "DEBUG" "Setting $key=$value" "$LINENO"
        fi
    done <<<"$jq_output"
}

# Function: Validate settings after the configuration file and command line are processed
validate_settings() {
    local setting
    for setting in CHECK_INTERVAL TIMEOUT; do
        if ! get_interval_in_seconds "${!setting}" >/dev/null; then
            log_message "FATAL" "$setting must be a whole number with an optional s, m, h or d suffix (for example 30s or 5m), not '${!setting}'." "$LINENO"
            exit 1
        fi
    done

    if [[ ! "$REPEAT" =~ ^[0-9]+$ ]]; then
        log_message "FATAL" "REPEAT must be a whole number, not '$REPEAT'." "$LINENO"
        exit 1
    fi

    validate_app_settings
}

# Function: Get all URL groups and return them sorted
get_connection_groups() {
    local config_file_path="$1"
    jq -r '(.urls // {}) | keys | sort[]' "$config_file_path"
}

# Function: Check if a key exists in the SKIP_CONFIG_KEYS
key_exists() {
    array_contains "$1" "${SKIP_CONFIG_KEYS[@]}"
}

# Function: Get URL settings as key-value pairs
# shellcheck disable=SC2034 # result_array is written through a nameref
get_url_settings() {
    local group="$1"
    local index="$2"
    local config_file_path="$3"
    local -n result_array=$4
    local key value

    while IFS="=" read -r key value; do
        result_array["$key"]="$value"
        log_message "DEBUG" "$key=$value" "$LINENO"
    done < <(jq -r --arg group "$group" --argjson index "$index" \
        '.urls[$group][$index] | to_entries[] | "\(.key)=\(.value // "" | tostring)"' "$config_file_path")
}

# Function: Show configuration file
show_config_file() {
    log_message "INFO" "Configuration file: $CONFIG_FILE" "$LINENO"
    log_message "INFO" "" "$LINENO"
    if [[ -f "$CONFIG_FILE" ]]; then
        cat "$CONFIG_FILE"
    else
        log_message "ERROR" "Configuration file not found: $CONFIG_FILE" "$LINENO"
    fi
    log_message "INFO" "" "$LINENO"
    exit 0
}

# Function: Initialize the configuration file
init_config() {
    # Ensure the directory for the configuration file exists
    local config_dir
    config_dir=$(dirname "$CONFIG_FILE")
    if [[ ! -d "$config_dir" ]]; then
        printf "Configuration file directory %s does not exist. Creating it...\n" "$config_dir"
        mkdir -p "$config_dir" || {
            log_message "FATAL" "Failed to create directory: $config_dir" "$LINENO"
            exit 1
        }
    fi

    # Check if the configuration file already exists
    if [[ -f "$CONFIG_FILE" ]]; then
        if [[ "$INIT_FORCE" = true ]]; then
            printf "FORCE is true. Replacing the existing configuration file...\n"
        elif [[ ! -t 0 ]]; then
            log_message "FATAL" "Configuration file $CONFIG_FILE already exists. Use --force-init to replace it." "$LINENO"
            exit 1
        else
            local choice
            read -r -p "Configuration file $CONFIG_FILE already exists. Do you want to replace it? (y/n): " choice
            case "$choice" in
            y | Y)
                printf "Replacing the existing configuration file...\n"
                ;;
            n | N)
                printf "Keeping the existing configuration file.\n"
                exit 0
                ;;
            *)
                printf "Invalid choice. Keeping the existing configuration file.\n"
                exit 0
                ;;
            esac
        fi
    fi

    # Create the configuration content
    local config_content
    if ! config_content=$(default_config_json); then
        log_message "FATAL" "Failed to build the default configuration." "$LINENO"
        exit 1
    fi

    # Write the configuration, readable only by the current user because it can hold API keys
    if ! (umask 077 && printf "%s\n" "$config_content" >"$CONFIG_FILE"); then
        log_message "FATAL" "Failed to create configuration file at $CONFIG_FILE" "$LINENO"
        exit 1
    fi

    log_message "INFO" "Default configuration file created at $CONFIG_FILE" "$LINENO"
    exit 0
}

# Function: Build the default configuration as JSON
default_config_json() {
    jq -n \
        --arg CACHE_DIR "$CACHE_DIR" \
        --arg LOG_FILE "$LOG_FILE" \
        --arg CHECK_INTERVAL "$CHECK_INTERVAL" \
        --arg TIMEOUT "$TIMEOUT" \
        --arg SYSTEM_NAME "$SYSTEM_NAME" \
        --arg PUSHOVER_NOTIFICATION "$PUSHOVER_NOTIFICATION" \
        --arg PUSHOVER_USER_KEY "$PUSHOVER_USER_KEY" \
        --arg PUSHOVER_API_TOKEN "$PUSHOVER_API_TOKEN" \
        --arg DESKTOP_NOTIFICATION "$DESKTOP_NOTIFICATION" \
        --arg VERBOSE "$VERBOSE" \
        --arg LOG_LEVEL "$LOG_LEVEL" \
        --arg THRESHOLD "$THRESHOLD" \
        '{
            configuration: {
                CACHE_DIR: $CACHE_DIR,
                LOG_FILE: $LOG_FILE,
                CHECK_INTERVAL: $CHECK_INTERVAL,
                TIMEOUT: $TIMEOUT,
                SYSTEM_NAME: $SYSTEM_NAME,
                PUSHOVER_NOTIFICATION: $PUSHOVER_NOTIFICATION,
                PUSHOVER_USER_KEY: $PUSHOVER_USER_KEY,
                PUSHOVER_API_TOKEN: $PUSHOVER_API_TOKEN,
                DESKTOP_NOTIFICATION: $DESKTOP_NOTIFICATION,
                VERBOSE: $VERBOSE,
                LOG_LEVEL: $LOG_LEVEL,
                THRESHOLD: $THRESHOLD
            },
            urls: {
                default: [
                    {
                        NAME: "Apple Newsroom",
                        URL: "https://www.apple.com/newsroom/",
                        TIMEOUT: "5s",
                        THRESHOLD: "1",
                        UPDATED_CMD: "",
                        CMD_TIMEOUT: "5s"
                    },
                    {
                        NAME: "9to5mac Homepage",
                        URL: "https://9to5mac.com",
                        TIMEOUT: "10s",
                        THRESHOLD: "15",
                        UPDATED_CMD: "",
                        CMD_TIMEOUT: "5s"
                    }
                ]
            }
        }'
}

# Function: Show configuration information
show_config() {
    log_message "INFO" "Configuration file: $CONFIG_FILE" "$LINENO"
    log_message "INFO" "Cache directory: $CACHE_DIR" "$LINENO"
    log_message "INFO" "Log file: $LOG_FILE" "$LINENO"
    log_message "INFO" "PID file: $PID_FILE" "$LINENO"
    log_message "INFO" "Log Level: $LOG_LEVEL" "$LINENO"
    log_message "INFO" "Verbose enabled: $VERBOSE" "$LINENO"
    log_message "INFO" "System Name: $SYSTEM_NAME" "$LINENO"
    log_message "INFO" "Pushover enabled: $PUSHOVER_NOTIFICATION" "$LINENO"
    log_message "INFO" "Desktop notification enabled: $DESKTOP_NOTIFICATION" "$LINENO"
    log_message "INFO" "Check interval: $CHECK_INTERVAL" "$LINENO"
    log_message "INFO" "Timeout interval: $TIMEOUT" "$LINENO"
    log_message "INFO" "Repeat times: ${REPEAT:-0}" "$LINENO"
    log_message "INFO" "Threshold for changes: $THRESHOLD" "$LINENO"
}

