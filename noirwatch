# Function: Validate app specific settings
validate_app_settings() {
    if [[ ! "$THRESHOLD" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        log_message "FATAL" "THRESHOLD must be a number from 0 to 100, not '$THRESHOLD'." "$LINENO"
        exit 1
    fi
}

# Function: Exit with an error if there is no configuration file to read URLs from
require_config_file() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_message "FATAL" "No URLs given and no configuration file found at $CONFIG_FILE. Pass URLs or run with --init." "$LINENO"
        exit 1
    fi
}

# Function: Show URL configuration file
show_urls() {
    require_config_file
    log_message "INFO" "Configured URLs:" "$LINENO"

    # Get the connection groups
    local groups
    mapfile -t groups < <(get_connection_groups "$CONFIG_FILE")

    # Check if groups array is empty or null
    if [[ ${#groups[@]} -eq 0 ]]; then
        log_message "FATAL" "No connection groups found in the configuration file." "$LINENO"
        exit 1
    fi

    # Process the remaining groups
    local group urls i
    for group in "${groups[@]}"; do
        log_message "INFO" "Group: $group" "$LINENO"
        urls=$(jq -r --arg group "$group" '.urls[$group] | length' "$CONFIG_FILE")
        for ((i = 0; i < urls; i++)); do
            local -A url_result=()
            get_url_settings "$group" "$i" "$CONFIG_FILE" url_result
            log_message "INFO" "- Name: ${url_result["NAME"]}" "$LINENO"
            log_message "INFO" "- URL: ${url_result["URL"]}" "$LINENO"
            log_message "INFO" "- Threshold: ${url_result["THRESHOLD"]:-$THRESHOLD}" "$LINENO"
            log_message "INFO" "- Timeout: ${url_result["TIMEOUT"]:-$TIMEOUT}" "$LINENO"
            log_message "INFO" "- Updated Command: ${url_result["UPDATED_CMD"]}" "$LINENO"
        done
    done

    log_message "INFO" "" "$LINENO"
}

# Function: Build the XPath that selects the visible text of a page
build_content_xpath() {
    local conditions=()
    local element name

    for element in "${IGNORED_ELEMENTS[@]}"; do
        conditions+=("ancestor::$element")
    done

    # Page-level headers and footers are chrome; article headers often hold the headline, so keep those
    conditions+=("ancestor::header[not(ancestor::article)]" "ancestor::footer[not(ancestor::article)]")

    # Match whole class names so "ad" does not also match "heading" or "shadow"
    for name in "${IGNORED_NAMES[@]}"; do
        conditions+=("ancestor::*[contains(concat(' ', normalize-space(@class), ' '), ' $name ') or @id='$name']")
    done

    local joined
    printf -v joined "%s or " "${conditions[@]}"
    printf "//body//text()[normalize-space()][not(%s)]" "${joined% or }"
}

# Function: Normalize HTML content
normalize_content() {
    local file=$1

    if [[ ! -f "$file" ]]; then
        log_message "ERROR" "Input file does not exist: $file" "$LINENO"
        return 1
    fi

    local base_filename
    base_filename=$(basename "$file")

    # Save raw HTML for inspection if the LOG_LEVEL is DEBUG
    if log_at_or_above "DEBUG"; then
        cp "$file" "$CACHE_DIR/${base_filename}_debug_raw_html.txt"
    fi

    local temp_file
    if ! temp_file=$(mktemp "$CACHE_DIR/normalize.XXXXXX"); then
        log_message "ERROR" "Failed to create a temporary file in $CACHE_DIR" "$LINENO"
        return 1
    fi

    # Extract visible text, one line per text node, then collapse whitespace and drop empty lines
    xmllint --html --xpath "$(build_content_xpath)" "$file" 2>/dev/null |
        sed -E -e 's/[[:space:]]+/ /g' -e 's/^ //' -e 's/ $//' |
        grep -v '^$' >"$temp_file"

    # Pages that are not HTML, such as JSON or plain text, are compared as they are
    if [[ ! -s "$temp_file" ]]; then
        log_message "DEBUG" "No HTML text found. Comparing the raw content of: $file" "$LINENO"
        cp "$file" "$temp_file"
    fi

    if [[ ! -s "$temp_file" ]]; then
        log_message "WARN" "Normalized content is empty: $file" "$LINENO"
        rm -f "$temp_file"
        return 1
    fi

    # Debug: Save processed content for inspection if LOG_LEVEL is DEBUG
    if log_at_or_above "DEBUG"; then
        cp "$temp_file" "$CACHE_DIR/${base_filename}_debug_normalized.txt"
    fi

    # Replace the original file with the normalized content
    mv "$temp_file" "$file"
    log_message "DEBUG" "Content normalized successfully: $file" "$LINENO"
    return 0
}

# Function: Calculate change percentage
calculate_change_percentage() {
    local previous_file=$1
    local new_file=$2

    # Basic logging
    log_message "DEBUG" "Calculating change percentage" "$LINENO"
    log_message "DEBUG" "Previous file: $previous_file" "$LINENO"
    log_message "DEBUG" "New file: $new_file" "$LINENO"

    if [[ ! -f "$previous_file" || ! -f "$new_file" ]]; then
        log_message "ERROR" "One of the files for comparison does not exist." "$LINENO"
        echo 100 # Consider 100% change
        return 0
    fi

    # Calculate the number of lines in the previous file
    local previous_lines new_lines
    previous_lines=$(wc -l <"$previous_file" | tr -d '[:space:]')
    new_lines=$(wc -l <"$new_file" | tr -d '[:space:]')

    log_message "DEBUG" "Previous lines: $previous_lines" "$LINENO"
    log_message "DEBUG" "New lines: $new_lines" "$LINENO"

    if [[ "$previous_lines" -eq 0 && "$new_lines" -eq 0 ]]; then
        log_message "INFO" "Both files are empty. Assuming no change." "$LINENO"
        echo 0
        return 0
    fi

    # Handle empty previous file
    if [[ "$previous_lines" -eq 0 ]]; then
        log_message "WARN" "Previous file is empty. Assuming 100% change." "$LINENO"
        echo 100
        return 0
    fi

    # Count added and removed lines, skipping the two "---" and "+++" header lines
    local differing_lines
    differing_lines=$(diff -U 0 "$previous_file" "$new_file" | awk 'NR > 2 && /^[+-]/ { count++ } END { print count + 0 }')

    # Calculate change percentage
    local change_percentage
    change_percentage=$(awk -v changed="$differing_lines" -v total="$previous_lines" 'BEGIN { printf "%.2f", (changed / total) * 100 }')
    log_message "DEBUG" "Differing lines: $differing_lines" "$LINENO"
    log_message "DEBUG" "Change percentage: $change_percentage%" "$LINENO"

    # Debug: Save the diff output for inspection
    if log_at_or_above "DEBUG"; then
        diff "$previous_file" "$new_file" >"$CACHE_DIR/$(basename "$new_file")_debug_diff.txt"
    fi

    echo "$change_percentage"
    return 0
}

# Function: Check if a number is greater than or equal to another (supports decimals)
is_at_least() {
    awk -v value="$1" -v minimum="$2" 'BEGIN { exit !(value >= minimum) }'
}

# Function: Run the command configured for a URL after a change is detected
run_updated_command() {
    local -n cmd_settings=$1
    local updated_cmd=${cmd_settings["UPDATED_CMD"]}
    local timeout_duration

    [[ -n "$updated_cmd" ]] || return 0

    if ! timeout_duration=$(get_interval_in_seconds "${cmd_settings["CMD_TIMEOUT"]:-10s}"); then
        log_message "ERROR" "Invalid CMD_TIMEOUT '${cmd_settings["CMD_TIMEOUT"]}' for ${cmd_settings["URL"]}" "$LINENO"
        return 1
    fi

    if ! command -v "$updated_cmd" >/dev/null 2>&1; then
        log_message "ERROR" "Command $updated_cmd not found" "$LINENO"
        return 1
    fi

    log_message "DEBUG" "Running command: $updated_cmd" "$LINENO"

    # Serialize the associative array into a "KEY=value;" string
    local serialized_settings="" key
    for key in "${!cmd_settings[@]}"; do
        serialized_settings+="$key=${cmd_settings[$key]};"
    done

    local result exit_code
    result=$(timeout "$timeout_duration" "$updated_cmd" "$serialized_settings" 2>&1)
    exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log_message "ERROR" "Command $updated_cmd failed with exit code $exit_code and result: $result" "$LINENO"
        return 1
    fi

    log_message "DEBUG" "Command $updated_cmd results: $result" "$LINENO"
}

# Function: Check the website for changes
check_website() {
    local -n url_settings=$1
    local name=${url_settings["NAME"]:-${url_settings["URL"]}}
    local website_url=${url_settings["URL"]}
    local threshold=${url_settings["THRESHOLD"]:-$THRESHOLD}
    local timeout

    if [[ -z "$website_url" ]]; then
        log_message "ERROR" "Skipping an entry in group '${url_settings["GROUP"]}' because it has no URL." "$LINENO"
        return 1
    fi

    if ! timeout=$(get_interval_in_seconds "${url_settings["TIMEOUT"]:-$TIMEOUT}"); then
        log_message "ERROR" "Invalid TIMEOUT '${url_settings["TIMEOUT"]}' for $website_url" "$LINENO"
        return 1
    fi

    if [[ ! "$threshold" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        log_message "ERROR" "Invalid THRESHOLD '$threshold' for $website_url" "$LINENO"
        return 1
    fi

    local encoded_url
    encoded_url=$(printf "%s" "$website_url" | shasum -a 256 | awk '{print $1}')
    local previous_file="$CACHE_DIR/previous_content_${CACHE_FORMAT}_$encoded_url.txt"
    local current_file="$CACHE_DIR/current_content_${CACHE_FORMAT}_$encoded_url.txt"
    local hash_file="$CACHE_DIR/hash_${CACHE_FORMAT}_$encoded_url.txt"

    log_message "DEBUG" "$SYSTEM_NAME Checking URL:" "$LINENO"
    log_message "DEBUG" "Submitted URL: $website_url" "$LINENO"
    log_message "DEBUG" "Global threshold: $THRESHOLD%" "$LINENO"
    log_message "DEBUG" "Applied threshold: $threshold%" "$LINENO"

    # Fetch the current content of the website, following redirects over HTTP(S) only
    local curl_error
    if ! curl_error=$(curl --silent --show-error --fail --location --max-redirs 5 \
        --proto "=http,https" --proto-redir "=http,https" \
        --max-time "$timeout" --user-agent "$APP_NAME/$VERSION" \
        --output "$current_file" "$website_url" 2>&1); then
        log_message "ERROR" "Failed to fetch $website_url: $curl_error" "$LINENO"
        rm -f "$current_file"
        return 1
    fi

    # Normalize the content
    if ! normalize_content "$current_file"; then
        log_message "ERROR" "Failed to normalize content for: $website_url" "$LINENO"
        rm -f "$current_file"
        return 1
    fi

    # Generate hash of the normalized content
    local current_hash
    current_hash=$(shasum -a 256 "$current_file" | awk '{print $1}')
    url_settings["CURRENT_HASH"]="$current_hash"

    # Check for previous hash
    if [[ -f "$hash_file" && -f "$previous_file" ]]; then
        local previous_hash
        previous_hash=$(<"$hash_file")
        url_settings["PREVIOUS_HASH"]="$previous_hash"

        # Compare hashes
        if [[ "$current_hash" != "$previous_hash" ]]; then
            local change_percent
            change_percent=$(calculate_change_percentage "$previous_file" "$current_file")
            url_settings["CHANGED_PERCENT"]="$change_percent"

            # Notify if changes exceed threshold
            if is_at_least "$change_percent" "$threshold"; then
                local message="$SYSTEM_NAME: $name has changed by $change_percent%!"
                log_message "WARN" "$message" "$LINENO"
                send_pushover_notification "$APP_NAME Alert" "$message" "$website_url"
                send_desktop_notification "$APP_NAME Alert" "$message"
                run_updated_command url_settings
            else
                log_message "DEBUG" "Changes are below the threshold: ($change_percent%)" "$LINENO"
            fi
        else
            log_message "DEBUG" "No changes detected for: $name" "$LINENO"
        fi
    else
        log_message "DEBUG" "No previous content found for: $name" "$LINENO"
        log_message "DEBUG" "Saving current content for future comparison." "$LINENO"
    fi

    # Save the current hash and normalized content for the next comparison
    echo "$current_hash" >"$hash_file"
    mv "$current_file" "$previous_file"
    return 0
}

# ==============================
# Main Application Execution
# ==============================

# Function: Start the main process
main() {
    local repeat_count=0
    local interval
    interval=$(get_interval_in_seconds "$CHECK_INTERVAL")

    # Without URLs on the command line, they come from the configuration file
    [[ ${#CLI_URLS[@]} -eq 0 ]] && require_config_file

    while true; do
        log_message "DEBUG" "Current timestamp: $(date -u "+%Y-%m-%dT%H:%M:%SZ")" "$LINENO"

        # Start of main application function calls

        # If the URLs come from the CLI set the group to default
        local groups=()
        if [[ ${#CLI_URLS[@]} -gt 0 ]]; then
            groups=("default")
        else
            # Get the connection groups
            mapfile -t groups < <(get_connection_groups "$CONFIG_FILE")
        fi

        # Check if groups array is empty or null
        if [[ ${#groups[@]} -eq 0 ]]; then
            log_message "FATAL" "No connection groups or urls found." "$LINENO"
            exit 1
        fi

        # Process the remaining groups
        local group url_count i
        for group in "${groups[@]}"; do
            log_message "DEBUG" "Group: $group" "$LINENO"
            if [[ ${#CLI_URLS[@]} -gt 0 ]]; then
                url_count=${#CLI_URLS[@]}
            else
                url_count=$(jq -r --arg group "$group" '.urls[$group] | length' "$CONFIG_FILE")
            fi

            for ((i = 0; i < url_count; i++)); do
                # Assigning () resets the array so settings never carry over from the previous URL
                local -A url_result=()
                if [[ ${#CLI_URLS[@]} -gt 0 ]]; then
                    # A URL may start with a threshold in brackets, such as [15]https://example.com
                    if [[ "${CLI_URLS[$i]}" =~ ^\[([0-9]+(\.[0-9]+)?)\](.+)$ ]]; then
                        url_result["THRESHOLD"]="${BASH_REMATCH[1]}"
                        url_result["URL"]="${BASH_REMATCH[3]}"
                    else
                        url_result["THRESHOLD"]="$THRESHOLD"
                        url_result["URL"]="${CLI_URLS[$i]}"
                    fi
                else
                    get_url_settings "$group" "$i" "$CONFIG_FILE" url_result
                fi
                url_result["GROUP"]=$group

                check_website url_result
            done
        done

        # End of main application function calls

        # Increment the repeat counter
        repeat_count=$((repeat_count + 1))
        log_message "DEBUG" "Iteration: $repeat_count" "$LINENO"

        # Stop after REPEAT iterations unless REPEAT is 0 (run until stopped)
        if [[ "$REPEAT" -ne 0 && "$repeat_count" -ge "$REPEAT" ]]; then
            log_message "DEBUG" "Reached the maximum number of repetitions: $REPEAT" "$LINENO"
            break
        else
            log_message "DEBUG" "Sleeping for $CHECK_INTERVAL" "$LINENO"
            interruptible_sleep "$interval"
        fi
    done
}

# Call the function to check for required dependencies
check_dependencies

# Call the function to parse cli options
parse_cli_options "$@"

# Call the main function to start the process
start_process
